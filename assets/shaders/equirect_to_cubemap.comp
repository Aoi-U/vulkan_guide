#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, set = 0, binding = 0) uniform writeonly image2DArray outCubemap;
layout(set = 0, binding = 1) uniform sampler2D equirectangularMap;

const vec2 invAtan = vec2(0.15915494309, 0.31830988618); // 1 / (2 * PI), 1 / PI

// convert a 3d direction vector to 2d equirectangular coordinates
vec2 sampleSphericalMap(vec3 v)
{
	vec2 uv = vec2(atan(-v.z, -v.x), asin(clamp(-v.y, -1.0, 1.0))); 
	uv *= invAtan; // scale to [0, 1]
	uv += 0.5; // shift to [0, 1]
	return uv;
}

// convert a 2d equirectangular coordinate to a 3d direction vector for a given cube face
vec3 getCubeDirection(vec2 uv, uint face)
{
	vec3 dir;
	switch (face)
	{
		case 0: // +x
			dir = vec3(1.0, -uv.y, -uv.x);
			break;
		case 1: // -x
			dir = vec3(-1.0, -uv.y, uv.x);
			break;
		case 2: // +y
			dir = vec3(uv.x, 1.0, uv.y); 
			break;
		case 3: // -y
			dir = vec3(uv.x, -1.0, -uv.y);
			break;
		case 4: // +z
			dir = vec3(uv.x, -uv.y, 1.0);
			break;
		case 5: // -z
			dir = vec3(-uv.x, -uv.y, -1.0);
			break;
	}
	return normalize(dir);
}

void main()
{
	// get the 3d coordinate of the current pixel in the cubemap
	ivec3 coord = ivec3(gl_GlobalInvocationID.xyz); 
	ivec2 size = imageSize(outCubemap).xy; 
	if (coord.x >= size.x || coord.y >= size.y || coord.z >= 6) return; // bounds check

	// convert pixel coordinates to normalized device coordinates [-1, 1]
	vec2 uv = (vec2(coord.xy) + vec2(0.5)) / vec2(size); 
	vec2 clip = uv * 2.0 - 1.0; 

	// get the direction vector for the current cube face converted to equirectangular coordinates
	vec3 dir = getCubeDirection(clip, coord.z); 
	vec2 sphereUV = sampleSphericalMap(dir); 

	// sample the equirectangular map and write the color to the cubemap
	vec3 color = texture(equirectangularMap, sphereUV).rgb;
	imageStore(outCubemap, coord, vec4(color, 1.0));
}