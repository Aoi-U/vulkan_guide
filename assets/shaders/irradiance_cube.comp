#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image2DArray outIrradiance;
layout(set = 0, binding = 1) uniform samplerCube environmentMap;

const float PI = 3.14159265359;

// convert 2d equirectangular coordinates to a 3d direction vector for a given cube face
vec3 getCubeDirection(vec2 uv, uint face)
{
	vec3 dir;
	switch (face)
	{
		case 0: // +x
			dir = vec3(1.0, -uv.y, -uv.x);
			break;
		case 1: // -x
			dir = vec3(-1.0, -uv.y, uv.x);
			break;
		case 2: // +y
			dir = vec3(uv.x, 1.0, uv.y); 
			break;
		case 3: // -y
			dir = vec3(uv.x, -1.0, -uv.y);
			break;
		case 4: // +z
			dir = vec3(uv.x, -uv.y, 1.0);
			break;
		case 5: // -z
			dir = vec3(-uv.x, -uv.y, -1.0);
			break;
	}
	return normalize(dir);
}

void main()
{
	// get the 3D coordinate of the current pixel in the irradiance map
	ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
	ivec2 size = imageSize(outIrradiance).xy;
	if (coord.x >= size.x || coord.y >= size.y || coord.z >= 6) return; // bounds check

	// convert pixel coordinates to normalized device coordinates [-1, 1]
	vec2 uv = (vec2(coord.xy) + vec2(0.5)) / vec2(size);
	vec2 clip = uv * 2.0 - 1.0;
	vec3 N = getCubeDirection(clip, coord.z); // normal direction for current cube face

	// create orthonormal basis around N
	vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
	vec3 right = normalize(cross(up, N));
	up = cross(N, right);

	vec3 irradiance = vec3(0.0);
	float sampleDelta = 0.025; // sample step size
	float nrSamples = 0.0;

	// integrate (sum) over hemisphere oriented around the normal N
	for (float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta) {
		for (float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta) {
			vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
			vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * N;

			irradiance += texture(environmentMap, sampleVec).rgb * cos(theta) * sin(theta);
			nrSamples++;
		}
	}

	irradiance = PI * irradiance * (1.0 / nrSamples); // scale by PI and average
	imageStore(outIrradiance, coord, vec4(irradiance, 1.0));
}